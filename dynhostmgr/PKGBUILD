# Maintainer: Pascal Diehm <pdiehm8@gmail.com>
# shellcheck disable=SC2034,SC2154,SC2164

pkgname="dynhostmgr"
pkgver=0.1.0
pkgrel=3
pkgdesc="Dynamically update /etc/hosts with reachable addresses"
arch=("x86_64")
makedepends=("cargo")
source=("dynhostmgr.tgz" "dynhostmgr.service")
sha256sums=("SKIP" "SKIP")

prepare() {
  cd dynhostmgr
  cargo fetch --locked
}

build() {
  cd dynhostmgr
  cargo build --frozen --release
}

package() {
  install -Dm755 dynhostmgr/target/release/dynhostmgr "$pkgdir/usr/lib/dynhostmgr/dynhostmgr"
  install -Dm644 dynhostmgr.service "$pkgdir/usr/lib/systemd/system/dynhostmgr.service"
}
